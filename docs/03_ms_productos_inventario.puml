@startuml 03_ms_productos_inventario
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
skinparam nodesep 45
skinparam ranksep 55
title EduSaldo · MS Productos e Inventario (8083) · db_inventario\nCatálogo, ingreso manual de stock y ajustes

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
  Clases <<ref MS Usuarios>>: viven en MS Usuarios; aquí solo
  se guarda su id (sin relación JPA entre bases de datos).
endlegend

package "MS Usuarios y Auth (referencia)" #F7F7F7 {
  class Encargado <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
  class Administrador <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
}

package "MS Productos e Inventario" {

  enum EstadoRegistro {
    ACTIVO
    INACTIVO
  }

  enum TipoMovimientoInventario {
    INGRESO
    RESERVA
    LIBERACION
    ENTREGA
    DEVOLUCION
    AJUSTE
  }

  enum EstadoSolicitud {
    PENDIENTE
    APROBADA
    RECHAZADA
  }

  class Categoria {
    - nombre : String
    - estado : EstadoRegistro
    --
    + crear(nombre : String) : void «ADM»
    + editar(nombre : String) : void «ADM»
    + inactivar() : void «ADM»
  }

  class Producto {
    - sku : String
    - nombre : String
    - descripcion : String
    - imagenUrl : String
    - cursoNivel : String
    - precio : int
    - stockFisico : int
    - stockReservado : int
    - stockCritico : int
    - estado : EstadoRegistro
    --
    + getStockDisponible() : int «APO» «ALU» «ENC» «ADM»
    + esCritico() : boolean «ADM» «ENC»
    + ingresarStockManual(cant : int, ingresoId : Long, usuarioId : Long) : MovimientoInventario «SIS»
    + retenerStockPorReserva(cant : int, reservaId : Long, usuarioId : Long) : MovimientoInventario «SIS»
    + liberarStockRetenido(cant : int, reservaId : Long, usuarioId : Long) : MovimientoInventario «SIS»
    + descontarStockPorEntrega(cant : int, entregaId : Long, vieneDeReserva : boolean, usuarioId : Long) : MovimientoInventario «SIS»
    + reponerStockPorDevolucion(cant : int, devolucionId : Long, usuarioId : Long) : MovimientoInventario «SIS»
    + aplicarAjusteAprobado(cant : int, solicitudId : Long, adminId : Long) : MovimientoInventario «SIS»
    + editar(...) : void «ADM»
    + inactivar() : void «ADM»
  }

  class IngresoStock {
    - fecha : LocalDateTime
    - encargadoId : Long
    - proveedor : String [0..1]
    - documentoReferencia : String [0..1]
    - observacion : String [0..1]
    --
    + agregarDetalle(producto : Producto, cantidad : int) : void «ENC»
    + confirmar() : void «ENC»
  }

  class DetalleIngresoStock {
    - cantidad : int
  }

  class SolicitudAjusteStock {
    - cantidad : int
    - motivo : String
    - encargadoId : Long
    - estado : EstadoSolicitud
    - fechaSolicitud : LocalDateTime
    - administradorId : Long [0..1]
    - fechaResolucion : LocalDateTime [0..1]
    - motivoRechazo : String [0..1]
    --
    + solicitar(producto : Producto, cantidad : int, motivo : String) : void «ENC»
    + aprobar(adminId : Long) : MovimientoInventario «ADM»
    + rechazar(adminId : Long, motivoRechazo : String) : void «ADM»
  }

  class MovimientoInventario {
    - tipo : TipoMovimientoInventario
    - cantidad : int
    - stockResultante : int
    - fecha : LocalDateTime
    - referenciaId : Long [0..1]
    - usuarioId : Long
  }
}

' Relaciones de dominio internas
Categoria "1" -- "0..*" Producto : clasifica >
IngresoStock "1" *-- "1..*" DetalleIngresoStock : contiene >
DetalleIngresoStock "0..*" --> "1" Producto : abastece >
IngresoStock "0..*" ..> "1..*" Producto : 1. al confirmar incrementa en >
Producto "1" -- "0..*" SolicitudAjusteStock : sujeto a >
Producto "1" *-- "0..*" MovimientoInventario : 2. registra cada operación en >

' Referencias externas (hacia MS Usuarios por ID)
IngresoStock "0..*" ..> "1" Encargado : recepcionado por (encargadoId) >
SolicitudAjusteStock "0..*" ..> "1" Encargado : solicitada por (encargadoId) >
SolicitudAjusteStock "0..*" ..> "0..1" Administrador : resuelta por (administradorId) >

' Conexión de Enums con sus Clases
Categoria ..> EstadoRegistro : estado
Producto ..> EstadoRegistro : estado
Producto ..> TipoMovimientoInventario : genera >
MovimientoInventario ..> TipoMovimientoInventario : tipo
SolicitudAjusteStock ..> EstadoSolicitud : estado

note right of IngresoStock
  Reemplaza a MS Compras: el Encargado registra
  manualmente el stock que llega a la librería
  (uno o varios productos a la vez).
  El proveedor y el documento de referencia son
  textos libres opcionales. Sin facturas ni CPP.
end note

note right of SolicitudAjusteStock
  Ajuste por diferencia de conteo físico:
  el Encargado solicita el ajuste indicando la
  diferencia y el motivo; el Administrador lo
  aprueba o rechaza. Solo al aprobarse se invoca
  Producto.aplicarAjusteAprobado().
end note

note bottom of Producto
  • stockDisponible = stockFisico − stockReservado ≥ 0.
  • Crítico: stockDisponible ≤ stockCritico.
  • Único punto de generación de MovimientoInventario (6 tipos):
    - INGRESO: ingresarStockManual()
    - RESERVA: retenerStockPorReserva()
    - LIBERACION: liberarStockRetenido()
    - ENTREGA: descontarStockPorEntrega()
    - DEVOLUCION: reponerStockPorDevolucion()
    - AJUSTE: aplicarAjusteAprobado()
end note
@enduml