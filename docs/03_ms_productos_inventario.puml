@startuml 03_ms_productos_inventario
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
title EduSaldo · MS Productos e Inventario (8083) · db_inventario\nCatálogo, ingreso manual de stock y ajustes

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
endlegend

package "MS Productos e Inventario" {

  enum EstadoRegistro {
    ACTIVO
    INACTIVO
  }

  enum TipoMovimientoInventario {
    INGRESO
    RESERVA
    LIBERACION
    ENTREGA
    DEVOLUCION
    AJUSTE
  }

  enum EstadoSolicitud {
    PENDIENTE
    APROBADA
    RECHAZADA
  }

  class Categoria <<Entity>> {
    - id : Long
    - nombre : String {unique}
    - estado : EstadoRegistro
    --
    + crear(...) : void «ADM»
    + inactivar() : void «ADM»
  }

  class Producto <<Entity>> {
    - id : Long
    - sku : String {unique}
    - nombre : String
    - descripcion : String
    - imagenUrl : String
    - cursoNivel : String
    - precioVenta : int
    - stockFisico : int
    - stockReservado : int
    - stockCritico : int
    - estado : EstadoRegistro
    --
    + getStockDisponible() : int «APO» «ALU» «ENC»
    + esCritico() : boolean «ADM» «ENC»
    + reservar(cant : int) : void «SIS»
    + liberar(cant : int) : void «SIS»
    + descontar(cant : int) : void «SIS»
    + reponer(cant : int) : void «SIS»
    + editar(...) : void «ADM»
    + inactivar() : void «ADM»
  }

  class Proveedor <<Entity>> {
    - id : Long
    - rut : String {unique}
    - razonSocial : String
    - contactoPrimerNombre : String
    - contactoPrimerApellido : String
    - correo : String
    - telefono : String
    - estado : EstadoRegistro
    --
    + crear(...) : void «ADM»
    + inactivar() : void «ADM»
  }

  class IngresoStock <<Entity>> {
    - id : Long
    - fecha : LocalDateTime
    - encargadoId : Long
    - documentoReferencia : String [0..1]
    - observacion : String [0..1]
    --
    + agregarDetalle(producto : Producto, cantidad : int) : void «ENC»
    + confirmar() : void «ENC»
  }

  class DetalleIngresoStock <<Entity>> {
    - id : Long
    - cantidad : int
    - costoUnitario : int [0..1]
  }

  class MovimientoInventario <<Entity>> {
    - id : Long
    - tipo : TipoMovimientoInventario
    - cantidad : int
    - stockResultante : int
    - fecha : LocalDateTime
    - referenciaId : Long [0..1]
    - usuarioId : Long
  }

  class SolicitudAjusteStock <<Entity>> {
    - id : Long
    - cantidad : int
    - motivo : String
    - solicitanteId : Long
    - estado : EstadoSolicitud
    - fechaSolicitud : LocalDateTime
    - aprobadorId : Long [0..1]
    - fechaResolucion : LocalDateTime [0..1]
    --
    + solicitar(...) : void «ENC»
    + aprobar(adminId : Long) : MovimientoInventario «ADM»
    + rechazar(adminId : Long, motivo : String) : void «ADM»
  }

  class InventarioFisico <<Entity>> {
    - id : Long
    - fecha : LocalDate
    - encargadoId : Long
    --
    + registrarConteo(producto : Producto, contado : int) : void «ENC»
    + finalizar() : List<SolicitudAjusteStock> «ENC»
  }

  class DetalleConteo <<Entity>> {
    - id : Long
    - stockSistema : int
    - stockContado : int
    --
    + getDiferencia() : int
  }
}

Categoria "1" -- "0..*" Producto : clasifica >
Proveedor "0..1" -- "0..*" IngresoStock : abastece >
IngresoStock "1" *-- "1..*" DetalleIngresoStock
DetalleIngresoStock "0..*" --> "1" Producto
Producto "1" *-- "0..*" MovimientoInventario : historial >
IngresoStock "1" ..> "1..*" MovimientoInventario : genera INGRESO >
Producto "1" -- "0..*" SolicitudAjusteStock
SolicitudAjusteStock "1" ..> "0..1" MovimientoInventario : genera AJUSTE >
InventarioFisico "1" *-- "1..*" DetalleConteo
DetalleConteo "0..*" --> "1" Producto
DetalleConteo "1" ..> "0..1" SolicitudAjusteStock : diferencia origina >

note right of IngresoStock
  Reemplaza a MS Compras: el Encargado registra
  a mano el stock que llegó (cabecera + detalle,
  varios productos a la vez). Sin órdenes de compra,
  facturas ni pagos. Proveedor y costo son opcionales.
end note

note right of SolicitudAjusteStock
  Ajuste: el Encargado lo solicita y el
  Administrador lo aprueba o rechaza.
  Solo con la aprobación cambia el stock.
end note

note bottom of Producto
  stockDisponible = stockFisico − stockReservado ≥ 0.
  Crítico: stockDisponible ≤ stockCritico.
end note
@enduml
